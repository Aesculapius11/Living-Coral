<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <meta name="keywords" content="{% if keywords %}{% if keywords is string %}{{ keywords }}{% else %}{{ keywords | join(', ') }}{% endif %}{% elif tags %}{{ tags | join(', ') }}{% else %}{{ site.defaultKeywords | join(', ') }}{% endif %}" />
    <meta name="baidu-site-verification" content="codeva-PKJbIgixpy" />
    <meta id="theme-color" name="theme-color" content="#ffffff" />
    <link rel="shortcut icon" type="image/x-icon" href="{{ '/assets/favicon.ico' | url }}" />
    <link rel="icon" href="{{ '/assets/favicon.ico' | url }}" sizes="any" />
    <link rel="icon" type="image/png" sizes="64x64" href="{{ '/assets/favicon-64.png' | url }}" />
    <link rel="icon" type="image/png" sizes="72x72" href="{{ '/assets/favicon-72.png' | url }}" />
    <link rel="icon" type="image/png" sizes="96x96" href="{{ '/assets/favicon-96.png' | url }}" />
    <link rel="icon" type="image/png" sizes="128x128" href="{{ '/assets/favicon-128.png' | url }}" />
    <link rel="icon" type="image/png" sizes="144x144" href="{{ '/assets/favicon-144.png' | url }}" />
    <link rel="icon" type="image/png" sizes="192x192" href="{{ '/assets/favicon-192.png' | url }}" />
    <link rel="icon" type="image/png" sizes="256x256" href="{{ '/assets/favicon-256.png' | url }}" />
    <link rel="icon" type="image/png" sizes="512x512" href="{{ '/assets/favicon-512.png' | url }}" />
    <link rel="apple-touch-icon" href="{{ '/assets/favicon-180.png' | url }}" /> 
    <!-- DNS Prefetch -->
    <link rel="dns-prefetch" href="//fonts.googleapis.com">
    <link rel="dns-prefetch" href="//fonts.gstatic.com">
    <link rel="dns-prefetch" href="//unpkg.com">
    <link rel="dns-prefetch" href="//cdn.jsdelivr.net">
    <link rel="dns-prefetch" href="//cloud.umami.is">
    <link rel="dns-prefetch" href="//img.antares.xin">
    <link rel="dns-prefetch" href="//randomimg.antares.xin">
    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://unpkg.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://cloud.umami.is" crossorigin>
    <link rel="preconnect" href="https://img.antares.xin" crossorigin>
    <link rel="preconnect" href="https://randomimg.antares.xin" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ '/assets/styles.css' | url }}" />
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css" />
    {% if page.url and page.url.match('/blog/') %}
      <!-- Prism 浅/深色主题（供 @11ty/eleventy-plugin-syntaxhighlight 使用） -->
      <link id="prism-theme-light" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/prismjs@1/themes/prism.min.css" disabled>
      <link id="prism-theme-dark" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/prismjs@1/themes/prism-tomorrow.min.css" disabled>
    {% endif %}
    <script src="{{ '/assets/img.js' | url }}"></script>
    <script>
      (function(){
        try{
          var html = document.documentElement;
          var light = document.getElementById('prism-theme-light');
          var dark = document.getElementById('prism-theme-dark');
          function apply(){
            var isDark = html.classList.contains('dark');
            if (light && dark){
              light.disabled = !!isDark;
              dark.disabled = !isDark;
            }
          }
          apply();
          // 监听 class 变化以便主题切换时更新
          var mo = new MutationObserver(apply);
          mo.observe(html, { attributes: true, attributeFilter: ['class'] });
        }catch(e){}
      })();
    </script>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="54bf0eb6-e9fe-4e83-921e-6ca6b90191cc"></script>
    <style>
      :root { --brand: {{ site.themeColor }}; }
      .brand { color: var(--brand); }
      .btn-brand { background: var(--brand); color: white; }
      .btn-brand:hover { filter: brightness(0.95); }
    </style>
    <script>
      (function(){
        try{
          const t = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (t === 'dark' || (!t && prefersDark)) document.documentElement.classList.add('dark');
          // 初始化 theme-color
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', (document.documentElement.classList.contains('dark') ? '#0a0a0a' : '#ffffff'));
        }catch(e){}
      })();
    </script>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9153977338785118"
     crossorigin="anonymous"></script> //add google adsense
  </head>
  <body class="font-sans bg-white text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100">
    {% include "../components/header.njk" %}

    <main class="pt-16">
      {{ content | safe }}
    </main>

    {% include "../components/footer.njk" %}

    <script src="{{ '/assets/main.js' | url }}"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script>AOS.init({ once: true, duration: 700, easing: 'ease-out-cubic'});</script>

    <script defer src="{{ '/assets/scroll.js' | url }}"></script>
    <button id="scrollToTopBtn" title="回到顶部" class="fixed bottom-8 right-8 z-50 shadow-lg transition-opacity duration-300 focus:outline-none focus:ring-brand dark:focus:ring-brand/50 hidden">
    <img src="{{ '/assets/scroll.png' | url }}" alt="回到顶部">
    </button>

  </body>
</html>


